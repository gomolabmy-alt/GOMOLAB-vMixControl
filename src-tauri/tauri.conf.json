{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GOMOLAB vMix Control",
  "version": "1.0.4",
  "identifier": "com.gomolab.vmixcontrol",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GOMOLAB vMix Control",
        "width": 1280,
        "height": 800,
        "minWidth": 700,
        "minHeight": 500,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["gomolab"]
      }
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/gomolabmy-alt/GOMOLAB-vMixControl/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFGRUVENDUzQkQ3QUU5MDEKUldRQjZYcTlVOVR1SDZHQ3hnVEpBUVo0SFBpSmYwSjQzVVBYdmNBT21VeUV2S0FmVUkrNXp5ZlEK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    }
  }
}
